{
  "permissions": {
    "allow": [
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_projects",
      "mcp__Supabase",
      "mcp__claude_ai_Supabase",
      "mcp__claude_ai_Supabase__execute_sql",
      "mcp__claude_ai_Supabase__list_tables",
      "mcp__claude_ai_Supabase__list_projects",
      "mcp__plugin_supabase_supabase",
      "mcp__plugin_supabase_supabase__execute_sql",
      "Bash(python -I pipelines/sql.py:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull --no-edit"
          },
          {
            "type": "command",
            "command": "python pipelines/rappel_debut.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python pipelines/garde_push.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python pipelines/garde_push.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python pipelines/police.py"
          },
          {
            "type": "command",
            "command": "python pipelines/forme.py"
          },
          {
            "type": "command",
            "command": "python pipelines/controle.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python pipelines/police.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/statusline.ps1",
    "padding": 0
  }
}
